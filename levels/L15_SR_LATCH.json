{
  "code": "L15_SR_LATCH",
  "title": "SR 锁存器（用 NOR 交叉反馈）",
  "description": "用两个 Nor 门交叉反馈实现 SR 锁存器（S/R 高有效）：S=1置位，R=1复位，S=R=0保持。请输出 Q 与 Qn。",
  "allowedComponents": ["Or", "Not", "Button", "Lamp"],
  "allowCycles": true,
  "devices": {
    "S": { "type": "Button", "label": "S", "x": 40, "y": 80 },
    "R": { "type": "Button", "label": "R", "x": 40, "y": 160 },

    "Q": { "type": "Lamp", "label": "Q", "x": 620, "y": 90 },
    "Qn": { "type": "Lamp", "label": "Qn", "x": 620, "y": 170 }
  },
  "kpIds": ["DC-SEQ-02"],
  "templateCircuit": null,
  "testCases": [
    {
      "name": "sequence-hold-set-reset",
      "orderIndex": 1,
      "steps": [
        { "stepIndex": 0, "inputs": { "S": 0, "R": 1 }, "expected": { "Q": 0, "Qn": 1 } },
        { "stepIndex": 1, "inputs": { "S": 0, "R": 0 }, "expected": { "Q": 0, "Qn": 1 } },
        { "stepIndex": 2, "inputs": { "S": 1, "R": 0 }, "expected": { "Q": 1, "Qn": 0 } },
        { "stepIndex": 3, "inputs": { "S": 0, "R": 0 }, "expected": { "Q": 1, "Qn": 0 } },
        { "stepIndex": 4, "inputs": { "S": 0, "R": 1 }, "expected": { "Q": 0, "Qn": 1 } }
      ]
    }
  ]
