{
  "code": "L20_RAM_2x1_DFF",
  "title": "2×1bit RAM（用 DFF + 译码/选择实现）",
  "description": "实现 2-word 1-bit 存储：地址 A 选择字；CLK 上升沿在 WE=1 时写入 D；输出 Y 为当前地址读出值。RST 清零两字。",
  "allowedComponents": ["Dff", "And", "Or", "Not", "Button", "Lamp", "Repeater"],
  "devices": {
    "A": { "type": "Button", "label": "A(addr)", "x": 40, "y": 40 },
    "D": { "type": "Button", "label": "D(data)", "x": 40, "y": 110 },
    "WE": { "type": "Button", "label": "WE", "x": 40, "y": 180 },
    "CLK": { "type": "Button", "label": "CLK", "x": 40, "y": 250 },
    "RST": { "type": "Button", "label": "RST", "x": 40, "y": 320 },

    "M0": { "type": "Dff", "label": "M0", "x": 300, "y": 120, "bits": 1, "polarity.clock": true, "polarity.arst": true, "polarity.enable": true, "arst_value": "0", "initial": "0" },
    "M1": { "type": "Dff", "label": "M1", "x": 420, "y": 120, "bits": 1, "polarity.clock": true, "polarity.arst": true, "polarity.enable": true, "arst_value": "0", "initial": "0" },

    "Y": { "type": "Lamp", "label": "Y", "x": 620, "y": 170 }
  },
  "kpIds": ["DC-MEM-01"],
  "templateCircuit": null,
  "testCases": [
    {
      "name": "write-read-sequence",
      "orderIndex": 1,
      "steps": [
        { "stepIndex": 0, "inputs": { "RST": 1, "CLK": 0, "WE": 0, "A": 0, "D": 0 }, "expected": { "Y": 0 } },
        { "stepIndex": 1, "inputs": { "RST": 0, "CLK": 0, "WE": 0, "A": 0, "D": 0 }, "expected": { "Y": 0 } },

        { "stepIndex": 2, "inputs": { "RST": 0, "CLK": 0, "WE": 1, "A": 0, "D": 1 }, "expected": { "Y": 0 } },
        { "stepIndex": 3, "inputs": { "RST": 0, "CLK": 1, "WE": 1, "A": 0, "D": 1 }, "expected": { "Y": 1 } },
        { "stepIndex": 4, "inputs": { "RST": 0, "CLK": 0, "WE": 0, "A": 0, "D": 0 }, "expected": { "Y": 1 } },

        { "stepIndex": 5, "inputs": { "RST": 0, "CLK": 0, "WE": 1, "A": 1, "D": 1 }, "expected": { "Y": 0 } },
        { "stepIndex": 6, "inputs": { "RST": 0, "CLK": 1, "WE": 1, "A": 1, "D": 1 }, "expected": { "Y": 1 } },
        { "stepIndex": 7, "inputs": { "RST": 0, "CLK": 0, "WE": 0, "A": 1, "D": 0 }, "expected": { "Y": 1 } },

        { "stepIndex": 8, "inputs": { "RST": 0, "CLK": 0, "WE": 1, "A": 0, "D": 0 }, "expected": { "Y": 1 } },
        { "stepIndex": 9, "inputs": { "RST": 0, "CLK": 1, "WE": 1, "A": 0, "D": 0 }, "expected": { "Y": 0 } },

        { "stepIndex": 10, "inputs": { "RST": 0, "CLK": 0, "WE": 0, "A": 0, "D": 0 }, "expected": { "Y": 0 } },
        { "stepIndex": 11, "inputs": { "RST": 0, "CLK": 0, "WE": 0, "A": 1, "D": 0 }, "expected": { "Y": 1 } }
      ]
    }
  ]
