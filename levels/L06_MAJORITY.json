{
  "code": "L06_MAJORITY",
  "title": "组合逻辑设计：三输入多数表决",
  "description": "实现多数表决：当 A,B,C 中至少两个为 1 时，Y=1，否则 Y=0。",
  "allowedComponents": ["And", "Or", "Not", "Button", "Lamp", "Repeater"],
  "devices": {
    "A": { "type": "Button", "label": "A", "x": 40, "y": 40 },
    "B": { "type": "Button", "label": "B", "x": 40, "y": 120 },
    "C": { "type": "Button", "label": "C", "x": 40, "y": 200 },
    "Y": { "type": "Lamp", "label": "Y", "x": 620, "y": 120 }
  },
  "kpIds": ["DC-COMB-01"],
  "templateCircuit": null,
  "testCases": [
    {
      "name": "truth-table",
      "orderIndex": 1,
      "steps": [
        { "stepIndex": 0, "inputs": { "A": 0, "B": 0, "C": 0 }, "expected": { "Y": 0 } },
        { "stepIndex": 1, "inputs": { "A": 0, "B": 0, "C": 1 }, "expected": { "Y": 0 } },
        { "stepIndex": 2, "inputs": { "A": 0, "B": 1, "C": 0 }, "expected": { "Y": 0 } },
        { "stepIndex": 3, "inputs": { "A": 0, "B": 1, "C": 1 }, "expected": { "Y": 1 } },
        { "stepIndex": 4, "inputs": { "A": 1, "B": 0, "C": 0 }, "expected": { "Y": 0 } },
        { "stepIndex": 5, "inputs": { "A": 1, "B": 0, "C": 1 }, "expected": { "Y": 1 } },
        { "stepIndex": 6, "inputs": { "A": 1, "B": 1, "C": 0 }, "expected": { "Y": 1 } },
        { "stepIndex": 7, "inputs": { "A": 1, "B": 1, "C": 1 }, "expected": { "Y": 1 } }
      ]
    }
  ]
}