    "B1": { "type": "Button", "label": "B1", "x": 40, "y": 160 },
    "B0": { "type": "Button", "label": "B0", "x": 40, "y": 220 },

    "GT": { "type": "Lamp", "label": "GT", "x": 620, "y": 60 },
    "EQ": { "type": "Lamp", "label": "EQ", "x": 620, "y": 130 },
    "LT": { "type": "Lamp", "label": "LT", "x": 620, "y": 200 }
  },
  "kpIds": ["DC-ARITH-04"],
  "templateCircuit": null,
